.streamlit/secrets.toml
.venv/
__pycache__/
*.pyc
.env
roster_maturity/data/

# Key Moments feed data: built fresh by the Actions Pages deploy (see
# .github/workflows/key_moments.yml), never committed.
docs/data/*.json

# Local preview builds (key_moments_build.py --sheet-id/--out-dir) used to
# validate archive-sheet edits before pasting them back into the real sheet.
docs/data/_preview/

# Immaculate Innings artifact: fetched plays and built outputs (tools/immaculate/build_artifact.py)
tools/immaculate/data/

# GM Tools / hitting lab working files
tools/diff_lab/cache/
tools/offense_lab/*.log
tools/offense_lab/*.done
docs/data/career/
docs/data/search/
tools/probe_output/pitch_screen/
tools/probe_output/pitch_model_fit/
tools/probe_output/pitch_calibration/
tools/probe_output/transitions/

# Sync change-tracking state (Actions cache locally mirrored by SYNC_STATE_PATH)
.sync_state/

# Local copy of the plays/players tables for analysis tools (tools/local_plays.py fetch)
tools/probe_output/plays_raw.pkl
